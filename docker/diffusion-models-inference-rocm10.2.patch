+# ROCm 10.2 nightly 20260927: the build ROCm/pytorch#3840 (AsyncTP) was validated
+# on, MI355X included; it carries the ROCr fix AsyncTP needs. Nightlies after
+# 20260822 are only on the native repository, which resolves the series itself.
+ARG ROCM_PACKAGE_REPOSITORY="native"
+ARG ROCM_RELEASE_ID="20260927-36281205442"
+ARG ROCM_DEB_SERIES="10.2"
 # ROCM_GFX_TARGETS selects architecture-specific nightly deb package shards.
 # PYTORCH_ROCM_ARCH defaults to the package targets but can be overridden.
