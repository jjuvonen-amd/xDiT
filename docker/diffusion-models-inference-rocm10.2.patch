+# PyTorch 2.14 from ROCm/pytorch release/2.14, whose head is the merge of
+# https://github.com/ROCm/pytorch/pull/3840: native AsyncTP (CK-tile GEMM) for
+# symm_mem.fused_all_gather_matmul on gfx942/gfx950. Opt in at runtime with
+# TORCH_SYMM_MEM_ENABLE_NATIVE_ASYNC_TP=1. It fires only for gather_dim 0,
+# contiguous A, one B, 2048 < local_M * world <= 4096 and local_M % 256 == 0;
+# other shapes take the decomposed symm_mem path. Needs USE_ROCM_CK_SDPA (set
+# below) and ROCm >= 10.1 on MI350. TRITON_COMMIT is that PyTorch commit's
+# .ci/docker/ci_commit_pins/triton.txt; vision is ROCm/vision release/0.29.
+ARG TRITON_COMMIT="a3c5afb73ecd9e70046a983a8dd18fd676a30438"
+ARG PYTORCH_COMMIT="cb5188625c2da92165616db2868382302432a21d"
+ARG PYTORCH_VISION_COMMIT="b7d540b22fab0df4673898fb0aec2fc6954cddac"
 ARG PYTORCH_AUDIO_COMMIT="b3ec2afa3ae504ca600d5e08956eb13d6e2aee31"
 ARG PYTORCH_CODEC_COMMIT="dc0f10da1fa2c807dedb7ed97de7b36d762b968b"
 # deps image arguments
@@ -328,7 +339,8 @@
     CXXFLAGS="-I${ROCM_HOME}/include/roctracer -I${ROCM_HOME}/lib/rocm_sysdeps/include" \
