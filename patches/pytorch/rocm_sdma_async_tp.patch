+def _failure_message(
+    count: int, piece: int, call: int, status: int, missing: int
+) -> str:
+    rank = dist.get_rank() if dist.is_initialized() else "?"
+    plans = {name: dict(zip(g.peers, g.engines)) for name, g in _groups.items()}
+    if status:
+        first = f"the host-function node of captured call {call} failed with {status}"
+    else:
+        words = [i for i in range(MAX_WORLD) if missing >> i & 1]
+        first = (
+            f"call {call}, piece {piece}: flag words {words} never set (word r is group rank r's) "
+            f"after {_timeout_s():g} s"
+        )
+    return f"rank {rank}: {count} symm_mem SDMA failure(s). First: {first}. SDMA engine per peer rank: {plans}"
