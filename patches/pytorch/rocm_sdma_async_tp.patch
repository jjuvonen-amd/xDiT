+    flags.zero_()
+    flags[:, rank] = 1
+    out = x.new_empty(rows, out_features)
+    # Every rank's inbox is free and its flags cleared past this barrier.
+    _barrier(ws)
+    # As for the all-gather: issued while the GPU runs the kernels above; each piece waits for its release.
+    plan.start(stream)
+
+    def reduce(c: int) -> None:
+        plan.wait(stream, flags[c], c)
