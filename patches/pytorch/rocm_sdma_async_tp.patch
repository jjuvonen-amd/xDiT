+# The SDMA path on any ROCm GPU, validated or not (see _rocm_sdma.py).
+_ROCM_SDMA_ENV = {
+    "TORCH_SYMM_MEM_ENABLE_ROCM_SDMA": "1",
+    "TORCH_SYMM_MEM_ROCM_SDMA_ALLOW_UNTESTED": "1",
+}
+
+
+@skipIf(not TEST_WITH_ROCM, "the SDMA path of the fused ops is ROCm only")
+@skipIf(not PLATFORM_SUPPORTS_SYMM_MEM, "SymmMem is not supported on this ROCm arch")
+@instantiate_parametrized_tests
+@requires_accelerator_p2p_access()
+class AsyncTPRocmSdmaTest(MultiProcContinuousTest):
+    """The fused ops with TORCH_SYMM_MEM_ENABLE_ROCM_SDMA=1 match their fallbacks,
+    and the cases the SDMA path supports take it."""
+
+    @property
+    def device(self) -> torch.device:
+        return torch.device(device_type, self.rank)
+
+    def _init_process(self):
+        device_module.set_device(self.device)
+        torch.manual_seed(42 + self.rank)
+
+    @staticmethod
+    def _sdma_calls(op: str) -> int:
+        from torch.distributed._symmetric_memory import _rocm_sdma
+
+        return _rocm_sdma.num_calls[op]
+
+    def _assert_close_to_fp32(self, actual, expected) -> None:
+        # bf16 results against an fp32 reference of the same bf16 inputs: the
+        # fallback's own bf16 reduce-scatter rounds each partial sum it adds,
+        # so it is no closer to the exact result than this path.
+        scale = expected.abs().max().item()
+        torch.testing.assert_close(
+            actual.float(), expected, rtol=2e-2, atol=1e-2 * scale
+        )
+
+    @skip_if_lt_x_gpu(2)
+    @parametrize("gather_dim", [0, 1, 2])
+    @mock.patch.dict(os.environ, _ROCM_SDMA_ENV)
+    def test_fused_all_gather_matmul(self, gather_dim: int) -> None:
+        self._init_process()
+        BATCH, M, N, K = 8, 64, 16, 32
+        group_name = dist.group.WORLD.group_name
+        A_shard_shape = [BATCH, M, K]
+        A_shard_shape[gather_dim] //= self.world_size
+        A_shard = torch.rand(A_shard_shape, device=device_type)
+        Bs = [torch.rand(K, N, device=device_type) for _ in range(3)]
+
+        calls = self._sdma_calls("fused_all_gather_matmul")
+        ag_0, mm_0 = _fused_all_gather_matmul_fallback(
+            A_shard, Bs, gather_dim=gather_dim, group_name=group_name
+        )
+        ag_1, mm_1 = torch.ops.symm_mem.fused_all_gather_matmul(
+            A_shard, Bs, gather_dim=gather_dim, group_name=group_name
+        )
+
+        # Gathering the last dim is left to the default path.
+        self.assertEqual(
+            self._sdma_calls("fused_all_gather_matmul") - calls,
+            0 if gather_dim == 2 else 1,
+        )
+        torch.testing.assert_close(ag_1, ag_0, rtol=0, atol=0)
+        self.assertEqual(ag_1.stride(), ag_0.stride())
+        for out_1, out_0 in zip(mm_1, mm_0):
+            torch.testing.assert_close(out_1, out_0)
+            self.assertEqual(out_1.stride(), out_0.stride())
+
+    @skip_if_lt_x_gpu(2)
+    @parametrize("scatter_dim", [0, 1, 2])
+    @mock.patch.dict(os.environ, _ROCM_SDMA_ENV)
