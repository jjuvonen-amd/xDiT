+    """all_gather(A_shard, gather_dim) @ B for every B in Bs, as symm_mem.fused_all_gather_matmul."""
+    lib = _load()
+    g = _group(group_name)
+    world, rank, n = g.world, g.rank, len(g.peers)
+    # As _fused_all_gather_matmul_impl: gather_dim first, flattened to rows.
+    A_shard_flat = A_shard.movedim(gather_dim, 0)
+    leading_dims = [world] + list(A_shard_flat.shape[:-1])
+    x = A_shard_flat.flatten(0, -2)
+    rows, features = x.shape
