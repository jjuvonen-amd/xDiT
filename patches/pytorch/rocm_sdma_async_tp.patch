+    one = _one(x.device).data_ptr()
+    for c in range(chunks):
+        # Piece c is pushed once its matmul is done: trigger c.
+        plan.push(
+            c,
+            [bases[p] + (c * world + rank) * block_bytes for p in g.peers],
+            [partials[c, p].data_ptr() for p in g.peers],
+            block_bytes,
+            [bases[p] + flag_offset + (c * world + rank) * 4 for p in g.peers],
+            one,
