+        """An exception on one rank between its pushes leaves no copy waiting: the rank raises,
+        its peers' waits for what it never sent end at once and are reported, and the next calls
+        are right."""
+        from torch.distributed._symmetric_memory import _rocm_sdma
+
+        self._init_process()
+        group_name = dist.group.WORLD.group_name
+        A_shard = torch.randn(256, 128, device=device_type, dtype=torch.bfloat16)
+        A = torch.randn(256 * self.world_size, 128, device=device_type, dtype=torch.bfloat16)
+        B = torch.randn(128, 64, device=device_type, dtype=torch.bfloat16)
+
+        def call():
+            if op == "all_gather":
+                return torch.ops.symm_mem.fused_all_gather_matmul(
+                    A_shard, [B], 0, group_name, return_A=False
+                )[1][0]
+            return torch.ops.symm_mem.fused_matmul_reduce_scatter(A, B, "sum", 0, group_name)
+
+        call()
+        device_module.synchronize()
+        _rocm_sdma.raise_if_failed()
+        # Rank 0 raises before its second piece's matmul: for the reduce-scatter, before it
+        # releases that piece's pushes.
+        start = time.monotonic()
+        with self._raise_in_bmm(1):
+            if self.rank == 0:
+                with self.assertRaisesRegex(RuntimeError, "injected"):
+                    call()
+            else:
+                call()
+        device_module.synchronize()
+        self.assertLess(time.monotonic() - start, 2.0)
+        dist.barrier()
+        self.assertIsNone(_rocm_sdma._broken)
+        if self.rank != 0 and op == "reduce_scatter":
+            with self.assertRaisesRegex(
+                RuntimeError, r"flag words \[0\] came from ranks that abandoned the call"
+            ):
+                _rocm_sdma.raise_if_failed()
+        else:
+            # The all-gather's pushes were all released before the exception.
+            try:
+                _rocm_sdma.raise_if_failed()
+            except RuntimeError as e:
