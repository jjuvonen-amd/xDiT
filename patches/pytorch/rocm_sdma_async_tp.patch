--- /dev/null
+++ b/torch/distributed/_symmetric_memory/_rocm_sdma.hip
@@ -0,0 +1,797 @@
+// SDMA transport for the ROCm path of
+// torch.ops.symm_mem.fused_all_gather_matmul and fused_matmul_reduce_scatter
+// (see _rocm_sdma.py). Built on first use with torch.utils.cpp_extension and
+// called through ctypes.
+//
+// Every copy is issued by the sending rank on its own SDMA engines and names
+// the local GPU on both sides: peers' inboxes are mapped in this process for
+// the local GPU. A call's pieces are pushed into every peer's inbox, one engine
+// per peer, all peers at once, queued in order on each engine. Once a peer's
+// copies of a piece land, a 4-byte write on a spare engine sets this rank's own
+// flag word for that piece at the peer (one word per sender, so no two engines
+// write the same word); on the data engines, a flag write that waits for its
+// piece would stall the next piece behind it.
+// Every data copy also waits for a trigger signal that a one-thread kernel
+// releases on the compute stream, so no copy starts before the stream reaches
+// that point.
+//
+// The host side of a call, arming its slot of signals and issuing its copies,
+// is a plan. An eager call runs its plan at once. A call captured into a graph
+// enqueues its plan as a host-function node, so every replay arms and issues
+// the copies when the stream reaches the call; the node only makes ROCr calls,
+// no HIP ones.
+//
+// The compute stream waits for a piece's flags with a one-thread kernel whose
+// wait is bounded: flags that never land are recorded in host-mapped memory
+// (rsdma_peek_error / rsdma_take_error), and the stream moves on. A plan that
+// fails inside a host-function node is recorded the same way.
+//
+// Inboxes and barrier words are plain device memory, mapped in peers' processes
+// with hipIpc handles (rsdma_ipc_alloc, rsdma_ipc_open), so the transport never
+// needs a symmetric-memory rendezvous. A barrier (rsdma_barrier) is a one-thread
+// kernel: it writes the barrier's epoch into every rank's arrival word for this
+// rank, then waits, bounded like a flag wait, until every rank's word at this
+// rank reaches it.
+//
+// No copy is left waiting when a call is abandoned or the process ends:
+// rsdma_drain (on an exception in a call, before the watchdog aborts, at exit,
+// and on SIGTERM) sets the word every flag write copies to 2, releases every
+// trigger and waits, bounded, for the copies. Peers' waits see 2 and fail at
+// once instead of timing out.
+//
+// Functions return 0 on success and a negative code otherwise.
+#include <hip/hip_runtime.h>
+#include <hsa/hsa.h>
+#include <hsa/hsa_ext_amd.h>
+
+#include <semaphore.h>
+#include <signal.h>
+
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+#include <thread>
+#include <vector>
+
+// A bounded flag wait that ran out of time, or a captured plan that failed,
+// written into host-visible memory.
+struct RsdmaError {
+  unsigned long long count; // failures since the last rsdma_take_error
+  // First one, a wait: bit i set if flag word i never read 1.
+  unsigned long long missing;
+  int piece; // first one: piece (-1 for a plan, -2 for a barrier) and call id
+  int call;
+  // First one: 0 for a wait that ran out of time (`missing` is the flag words,
+  // or for a barrier the ranks, never set), 1 for one whose flags came from
+  // senders that abandoned the call (`missing` is those words), else the failed
+  // plan's return code.
+  int status;
+};
+
+extern "C" int rsdma_drain(double seconds, int reset);
+
+namespace {
+
+struct Gpu {
+  hsa_agent_t agent;
+  uint32_t bus;
+};
+
+constexpr int kTriggers = 16; // per slot: one per piece at most
+
+struct Slot {
+  hsa_signal_t trigger[kTriggers];
+  volatile hsa_signal_value_t* trigger_value[kTriggers];
+  std::vector<hsa_signal_t> data; // one per data copy of a call
+  std::vector<hsa_signal_t> flag; // one per flag write of a call
+  int armed_data = 0; // what the last call on this slot used
+  int armed_flags = 0;
+};
+
+// Copy j to peer i is dst[i * m + j] <- src[i * m + j], bytes[j] bytes, on
+// engines[i] once trigger k is released; then, once peer i's m copies have
+// landed, the word at g_one goes to flag_dst[i] on the spare engine
+// engines[n].
+struct Push {
+  int k, n, m;
+  std::vector<uint64_t> bytes, dst, src, flag_dst;
+  std::vector<int> engines;
+};
+
+struct Plan {
+  int slot, n_data, n_flags, call;
+  double seconds; // how long to wait for the slot's previous copies
+  std::vector<Push> pushes; // push p is piece p of the call
+};
+
+std::vector<Gpu> g_gpus;
+std::vector<Slot> g_slots; // sized once by rsdma_init; never reallocated
+hsa_agent_t g_local;
+RsdmaError* g_error = nullptr; // host-mapped
+int* g_scratch = nullptr; // device word that a dropped flag write goes to
+// Device word every flag write copies: 1, or 2 once drained.
+int* g_one = nullptr;
+// Device array of every slot's trigger value pointers, for set_one.
+hsa_signal_value_t** g_trigger_values = nullptr;
+hipStream_t g_drain_stream = nullptr;
+sem_t g_term;
+struct sigaction g_old_term;
+constexpr double kDrainSeconds = 5.0;
+int g_drop_piece = -1, g_drop_index = -1;
+unsigned long long g_ticks_per_s = 0;
+
+hsa_status_t collect(hsa_agent_t agent, void*) {
+  hsa_device_type_t type;
+  hsa_agent_get_info(agent, HSA_AGENT_INFO_DEVICE, &type);
+  if (type == HSA_DEVICE_TYPE_GPU) {
+    uint32_t bdf = 0;
+    hsa_agent_get_info(agent, (hsa_agent_info_t)HSA_AMD_AGENT_INFO_BDFID, &bdf);
+    g_gpus.push_back({agent, (bdf >> 8) & 0xff});
+  }
+  return HSA_STATUS_SUCCESS;
+}
+
+int agent_of(int hip_dev, hsa_agent_t* out) {
+  hipDeviceProp_t prop;
+  if (hipGetDeviceProperties(&prop, hip_dev) != hipSuccess)
+    return -1;
+  for (const Gpu& g : g_gpus)
+    if (g.bus == (uint32_t)prop.pciBusID) {
+      *out = g.agent;
+      return 0;
+    }
+  return -2;
+}
+
+using Clock = std::chrono::steady_clock;
+
+Clock::time_point deadline_in(double seconds) {
+  return Clock::now() +
+      std::chrono::duration_cast<Clock::duration>(
+             std::chrono::duration<double>(seconds));
+}
+
+// Waits until `s` drops below 1 (its copy finished); false after `deadline`,
+// so a copy that never runs fails the call instead of hanging it.
+bool wait_done(hsa_signal_t s, Clock::time_point deadline) {
+  while (hsa_signal_load_scacquire(s) >= 1) {
+    if (Clock::now() > deadline)
+      return false;
+    hsa_signal_wait_scacquire(
+        s, HSA_SIGNAL_CONDITION_LT, 1, 1000000, HSA_WAIT_STATE_ACTIVE);
+  }
+  return true;
+}
+
+int lowest(uint32_t mask) {
+  for (int e = 0; e < 32; ++e)
+    if (mask >> e & 1)
+      return e;
+  return -1;
+}
+
+__global__ void release_trigger(hsa_signal_value_t* value) {
+  __hip_atomic_store(
+      value,
+      (hsa_signal_value_t)0,
+      __ATOMIC_RELEASE,
+      __HIP_MEMORY_SCOPE_SYSTEM);
+}
+
+// Sets *one to `value`; with `count` triggers, then releases them all.
+__global__ void set_one_and_release(
+    int* one,
+    int value,
+    hsa_signal_value_t** triggers,
+    int count) {
+  __hip_atomic_store(one, value, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_SYSTEM);
+  for (int i = 0; i < count; ++i)
+    __hip_atomic_store(
+        triggers[i],
+        (hsa_signal_value_t)0,
+        __ATOMIC_RELEASE,
+        __HIP_MEMORY_SCOPE_SYSTEM);
+}
+
+// Waits until all `count` words at `words` read 1 (acquire, system scope). A
+// word that reads 2 came from a sender that abandoned the call: the wait
+// records those words and returns at once. Otherwise, once `budget` wall-clock
+// ticks have passed, it records the words still missing and returns. Either
+// way the stream moves on; the host raises or aborts. Once one wait of a call
+// has failed, the call's later waits return at once, so a call spends at most
+// one timeout in its waits.
+__global__ void wait_flags(
+    const int* words,
+    int count,
+    unsigned long long budget,
+    RsdmaError* err,
+    int piece,
+    int call) {
+  unsigned long long start = wall_clock64();
+  if (__hip_atomic_load(&err->count, __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_SYSTEM) &&
+      __hip_atomic_load(&err->call, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_SYSTEM) ==
+          call)
+    return;
+  while (true) {
+    unsigned long long missing = 0, abandoned = 0;
+    for (int i = 0; i < count; ++i) {
+      int v = __hip_atomic_load(
+          words + i, __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_SYSTEM);
+      if (v == 2)
+        abandoned |= 1ull << i;
+      else if (v != 1)
+        missing |= 1ull << i;
+    }
+    if (!missing && !abandoned)
+      return;
+    if (abandoned || wall_clock64() - start > budget) {
+      if (__hip_atomic_fetch_add(
+              &err->count, 1ull, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_SYSTEM) ==
+          0) {
+        err->missing = abandoned ? abandoned : missing;
+        err->piece = piece;
+        err->call = call;
+        err->status = abandoned ? 1 : 0;
+      }
+      __threadfence_system();
+      return;
+    }
+    __builtin_amdgcn_s_sleep(2);
+  }
+}
+
+// Barrier of `world` ranks: increments the epoch at *epoch, writes it to word
+// `rank` of every rank's arrival words (peers[q] is rank q's, mapped here), then
+// waits until every word of its own, own[q], has reached it. A rank that is
+// ahead has written a later epoch, which counts too. Bounded as wait_flags: once
+// `budget` ticks have passed, the ranks still missing are recorded and the
+// stream moves on.
+__global__ void barrier(
+    unsigned long long* const* peers,
+    const unsigned long long* own,
+    int world,
+    int rank,
+    unsigned long long* epoch,
+    unsigned long long budget,
+    RsdmaError* err,
+    int call) {
+  unsigned long long start = wall_clock64();
+  unsigned long long e = *epoch + 1;
+  *epoch = e;
+  for (int q = 0; q < world; ++q)
+    __hip_atomic_store(
+        peers[q] + rank, e, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_SYSTEM);
+  while (true) {
+    unsigned long long missing = 0;
+    for (int q = 0; q < world; ++q) {
+      unsigned long long v = __hip_atomic_load(
+          own + q, __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_SYSTEM);
+      if ((long long)(v - e) < 0)
+        missing |= 1ull << q;
+    }
+    if (!missing)
+      return;
+    if (wall_clock64() - start > budget) {
+      if (__hip_atomic_fetch_add(
+              &err->count, 1ull, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_SYSTEM) ==
+          0) {
+        err->missing = missing;
+        err->piece = -2;
+        err->call = call;
+        err->status = 0;
+      }
+      __threadfence_system();
+      return;
+    }
+    __builtin_amdgcn_s_sleep(2);
+  }
+}
+
+// Launched once at init: fails to launch if the library has no code object for
+// this GPU.
+__global__ void probe(int* word) {
+  *word = 0;
+}
+
+// Grows `v` to `n` signals, all at value 0; false if ROCr cannot create one.
+bool grow(std::vector<hsa_signal_t>& v, int n) {
+  while ((int)v.size() < n) {
+    hsa_signal_t s;
+    if (hsa_signal_create(0, 0, nullptr, &s) != HSA_STATUS_SUCCESS)
+      return false;
+    v.push_back(s);
+  }
+  return true;
+}
+
+// Waits, up to `seconds` in all, for the copies of `slot`'s previous use to
+// finish, then sets its triggers to 1. Each data and flag signal is set to 1
+// only as its copy is issued, so one that was never issued is not waited for.
+int arm(int slot, int n_data, int n_flags, double seconds) {
+  Slot& s = g_slots[slot];
+  auto deadline = deadline_in(seconds);
+  for (int i = 0; i < s.armed_data; ++i)
+    if (!wait_done(s.data[i], deadline))
+      return -1000 - i; // data copy i never landed
+  for (int i = 0; i < s.armed_flags; ++i)
+    if (!wait_done(s.flag[i], deadline))
+      return -2000 - i; // flag write i never landed
+  // The slot is idle now, so it can grow for a call larger than any before.
+  if (!grow(s.data, n_data) || !grow(s.flag, n_flags))
+    return -1;
+  for (int k = 0; k < kTriggers; ++k)
+    hsa_signal_store_relaxed(s.trigger[k], 1);
+  s.armed_data = n_data;
+  s.armed_flags = n_flags;
+  return 0;
+}
+
+// Issues piece `piece` of a call on `slot`, using its data signals piece * n *
+// m onward and its flag signals piece * n onward.
+int issue(int slot, int piece, const Push& p) {
+  Slot& s = g_slots[slot];
+  int first = piece * p.n * p.m;
+  // Every piece waits for its trigger itself, rather than relying on queueing
+  // behind piece 0.
+  for (int c = 0; c < p.n * p.m; ++c) {
+    hsa_amd_sdma_engine_id_t engine =
+        (hsa_amd_sdma_engine_id_t)(1u << p.engines[c / p.m]);
+    hsa_signal_store_relaxed(s.data[first + c], 1);
+    hsa_status_t st = hsa_amd_memory_async_copy_on_engine(
+        (void*)p.dst[c],
+        g_local,
+        (const void*)p.src[c],
+        g_local,
+        p.bytes[c % p.m],
+        1,
+        &s.trigger[p.k],
+        s.data[first + c],
+        engine,
+        true);
+    if (st != HSA_STATUS_SUCCESS) {
+      hsa_signal_store_relaxed(s.data[first + c], 0);
+      return -100 - (int)st;
+    }
+  }
+  hsa_amd_sdma_engine_id_t spare =
+      (hsa_amd_sdma_engine_id_t)(1u << p.engines[p.n]);
+  for (int i = 0; i < p.n; ++i) {
+    void* flag = (void*)p.flag_dst[i];
+    if (piece == g_drop_piece &&
+        i == g_drop_index) { // test hook: this flag goes nowhere
+      flag = g_scratch;
+      g_drop_piece = g_drop_index = -1;
+    }
+    hsa_signal_store_relaxed(s.flag[piece * p.n + i], 1);
+    hsa_status_t st = hsa_amd_memory_async_copy_on_engine(
+        flag,
+        g_local,
+        g_one,
+        g_local,
+        4,
+        p.m,
+        &s.data[first + i * p.m],
+        s.flag[piece * p.n + i],
+        spare,
+        true);
+    if (st != HSA_STATUS_SUCCESS) {
+      hsa_signal_store_relaxed(s.flag[piece * p.n + i], 0);
+      return -200 - (int)st;
+    }
+  }
+  return 0;
+}
+
+int run(const Plan& plan) {
+  int rc = arm(plan.slot, plan.n_data, plan.n_flags, plan.seconds);
+  for (int i = 0; rc == 0 && i < (int)plan.pushes.size(); ++i)
+    rc = issue(plan.slot, i, plan.pushes[i]);
+  return rc;
+}
+
+// Host-function node of a captured call: runs its plan on every replay; a
+// failure is recorded for the watchdog (or the next eager call) to report, and
+// the call's flag waits time out.
+void run_node(void* data) {
+  const Plan* plan = static_cast<const Plan*>(data);
+  int rc = run(*plan);
+  if (rc != 0 &&
+      __atomic_fetch_add(&g_error->count, 1ull, __ATOMIC_RELAXED) == 0) {
+    g_error->missing = 0;
+    g_error->piece = -1;
+    g_error->call = plan->call;
+    g_error->status = rc;
+  }
+}
+
+// Sets *g_one to `one`, releasing every trigger with it if `release`, on the
+// drain stream; false if that is not done within `deadline`.
+bool set_one(int one, bool release, Clock::time_point deadline) {
+  int count = release ? (int)g_slots.size() * kTriggers : 0;
+  hipLaunchKernelGGL(
+      set_one_and_release,
+      dim3(1),
+      dim3(1),
+      0,
+      g_drain_stream,
+      g_one,
+      one,
+      g_trigger_values,
+      count);
+  if (hipGetLastError() != hipSuccess)
+    return false;
+  while (hipStreamQuery(g_drain_stream) == hipErrorNotReady) {
+    if (Clock::now() > deadline)
+      return false;
+    std::this_thread::yield();
+  }
+  return true;
+}
+
+// SIGTERM: drain (on a thread, as the handler may only post), then let the
+// previous disposition run.
+void on_term(int, siginfo_t*, void*) {
+  sem_post(&g_term);
+}
+
+void drain_on_term() {
+  while (sem_wait(&g_term) != 0) {
+  }
+  rsdma_drain(kDrainSeconds, 0);
+  sigaction(SIGTERM, &g_old_term, nullptr);
+  raise(SIGTERM);
+}
+
+} // namespace
+
+extern "C" {
+
+// Bumped whenever an exported signature or the meaning of a result changes;
+// _rocm_sdma.py refuses a library built from another version.
+int rsdma_abi_version() {
+  return 3;
+}
+
+// `slots` calls may be in flight at once; a slot is reused only after its
+// copies finished.
+int rsdma_init(int local_dev, int slots) {
+  if (!g_slots.empty())
+    return 0;
+  if (hsa_init() != HSA_STATUS_SUCCESS)
+    return -1;
+  if (hsa_iterate_agents(collect, nullptr) != HSA_STATUS_SUCCESS)
+    return -2;
+  if (agent_of(local_dev, &g_local))
+    return -3;
+  if (hipHostMalloc(
+          (void**)&g_error,
+          sizeof(RsdmaError),
+          hipHostMallocMapped | hipHostMallocCoherent) != hipSuccess)
+    return -8;
+  *g_error = RsdmaError{};
+  if (hipMalloc((void**)&g_scratch, 64) != hipSuccess)
+    return -9;
+  g_one = g_scratch + 1;
+  hipLaunchKernelGGL(probe, dim3(1), dim3(1), 0, 0, g_scratch);
+  if (hipGetLastError() != hipSuccess || hipDeviceSynchronize() != hipSuccess)
+    return -11; // no code for this GPU
+  int khz = 0;
+  if (hipDeviceGetAttribute(&khz, hipDeviceAttributeWallClockRate, local_dev) !=
+          hipSuccess ||
+      khz <= 0)
+    return -10;
+  g_ticks_per_s = (unsigned long long)khz * 1000ull;
+  if (hipStreamCreateWithFlags(&g_drain_stream, hipStreamNonBlocking) !=
+      hipSuccess)
+    return -12;
+  g_slots.resize(slots);
+  std::vector<hsa_signal_value_t*> values;
+  for (Slot& s : g_slots) {
+    // Triggers are written by a kernel, so their values must be addressable:
+    // GPU-only signals.
+    for (int k = 0; k < kTriggers; ++k) {
+      if (hsa_amd_signal_create(
+              0, 0, nullptr, HSA_AMD_SIGNAL_AMD_GPU_ONLY, &s.trigger[k]) !=
+          HSA_STATUS_SUCCESS)
+        return -4;
+      if (hsa_amd_signal_value_pointer(s.trigger[k], &s.trigger_value[k]) !=
+          HSA_STATUS_SUCCESS)
+        return -5;
+      values.push_back(const_cast<hsa_signal_value_t*>(s.trigger_value[k]));
+    }
+  }
+  size_t bytes = values.size() * sizeof(hsa_signal_value_t*);
+  if (hipMalloc((void**)&g_trigger_values, bytes) != hipSuccess ||
+      hipMemcpy(g_trigger_values, values.data(), bytes, hipMemcpyHostToDevice) !=
+          hipSuccess)
+    return -13;
+  if (!set_one(1, false, deadline_in(kDrainSeconds)))
+    return -14;
+  if (sem_init(&g_term, 0, 0) != 0)
+    return -15;
+  std::thread(drain_on_term).detach();
+  struct sigaction sa = {};
+  sa.sa_sigaction = on_term;
+  sa.sa_flags = SA_SIGINFO | SA_RESTART;
+  sigemptyset(&sa.sa_mask);
+  if (sigaction(SIGTERM, &sa, &g_old_term) != 0)
+    return -16;
+  return 0;
+}
+
+// Stops this process's copies from waiting on anything: sets the word every
+// flag write copies to 2, so peers' waits for them fail at once, releases
+// every trigger of every slot, then waits up to `seconds` in all for every
+// armed copy and flag write. With `reset`, once they have all finished, sets
+// the word back to 1 for later calls. Returns how many copies are still
+// pending (0 if none) or a negative code.
+int rsdma_drain(double seconds, int reset) {
+  if (g_slots.empty())
+    return 0;
+  auto deadline = deadline_in(seconds);
+  if (!set_one(2, true, deadline))
+    return -1;
+  int pending = 0;
+  for (Slot& s : g_slots) {
+    for (int i = 0; i < s.armed_data; ++i)
+      pending += !wait_done(s.data[i], deadline);
+    for (int i = 0; i < s.armed_flags; ++i)
+      pending += !wait_done(s.flag[i], deadline);
+  }
+  if (pending == 0 && reset && !set_one(1, false, deadline))
+    return -2;
+  return pending;
+}
+
+// One SDMA engine (bit index) per peer, in engines[0..n-1]: ROCr's preferred
+// engine for writing from `local_dev` to that peer; a peer whose preferred
+// engine is taken gets the lowest available engine no peer prefers (then any
+// free one). engines[n] is a spare engine, used by no peer, for the flag
+// writes.
+int rsdma_engine_plan(
+    int local_dev,
+    const int* peer_devs,
+    int n,
+    int* engines) {
+  hsa_agent_t local, peer;
+  if (agent_of(local_dev, &local))
+    return -1;
+  std::vector<uint32_t> avail(n), preferred(n, 0);
+  for (int i = 0; i < n; ++i) {
+    if (agent_of(peer_devs[i], &peer))
+      return -2;
+    if (hsa_amd_memory_copy_engine_status(peer, local, &avail[i]) !=
+        HSA_STATUS_SUCCESS)
+      return -3;
+    uint32_t mask = 0;
+    if (hsa_amd_memory_get_preferred_copy_engine(peer, local, &mask) ==
+        HSA_STATUS_SUCCESS)
+      preferred[i] = mask;
+  }
+  uint32_t used = 0, wanted = 0, everywhere = ~0u;
+  for (int i = 0; i < n; ++i) {
+    engines[i] = lowest(preferred[i] & avail[i]);
+    if (engines[i] >= 0)
+      wanted |= 1u << engines[i];
+    everywhere &= avail[i];
+  }
+  for (int i = 0; i < n; ++i) {
+    uint32_t bit = engines[i] >= 0 ? 1u << engines[i] : 0;
+    if (bit && !(used & bit)) {
+      used |= bit;
+      continue;
+    }
+    engines[i] = -1;
+  }
+  for (int i = 0; i < n; ++i) {
+    if (engines[i] >= 0)
+      continue;
+    int e = lowest(avail[i] & ~used & ~wanted);
+    if (e < 0)
+      e = lowest(avail[i] & ~used);
+    if (e < 0)
+      return -4;
+    engines[i] = e;
+    used |= 1u << e;
+  }
+  // The flag writes name the local GPU on both sides, like the data copies; any
+  // engine that every link offers will do, preferably one no peer uses.
+  engines[n] = lowest(everywhere & ~used);
+  if (engines[n] < 0)
+    engines[n] = lowest(everywhere);
+  return engines[n] < 0 ? -5 : 0;
+}
+
+// A plan for a call on `slot` of up to `n_data` data copies and `n_flags` flag
+// writes; null if the slot does not exist. Running it first waits up to
+// `seconds` for the slot's previous copies.
+void* rsdma_plan_new(int slot, int n_data, int n_flags, int call, double seconds) {
+  if (slot < 0 || slot >= (int)g_slots.size())
+    return nullptr;
+  return new Plan{slot, n_data, n_flags, call, seconds, {}};
+}
+
+// Adds the call's next piece (see Push).
+int rsdma_plan_push(
+    void* handle,
+    int k,
+    const uint64_t* dst,
+    const uint64_t* src,
+    const uint64_t* bytes,
+    const int* engines,
+    int n,
+    int m,
+    const uint64_t* flag_dst) {
+  Plan& plan = *static_cast<Plan*>(handle);
+  int piece = (int)plan.pushes.size();
+  if ((piece + 1) * n * m > plan.n_data || (piece + 1) * n > plan.n_flags ||
+      k < 0 || k >= kTriggers)
+    return -1;
+  plan.pushes.push_back(
+      Push{
+          k,
+          n,
+          m,
+          std::vector<uint64_t>(bytes, bytes + m),
+          std::vector<uint64_t>(dst, dst + n * m),
+          std::vector<uint64_t>(src, src + n * m),
+          std::vector<uint64_t>(flag_dst, flag_dst + n),
+          std::vector<int>(engines, engines + n + 1)});
+  return 0;
+}
+
+// Arms the plan's slot and issues its copies now; frees the plan.
+int rsdma_plan_run(void* handle) {
+  Plan* plan = static_cast<Plan*>(handle);
+  int rc = run(*plan);
+  delete plan;
+  return rc;
+}
+
+// Enqueues the plan on `stream` as a host function (during graph capture, a
+// host-function node): it runs when the stream reaches it, on every replay. The
+// plan is kept for as long as the process runs, as the graph may be replayed at
+// any time.
+int rsdma_plan_enqueue(void* handle, hipStream_t stream) {
+  return hipLaunchHostFunc(stream, run_node, handle) == hipSuccess ? 0 : -1;
+}
+
+// Enqueues the release of `slot`'s trigger `k` on `stream`: copies gated on it
+// start once the stream reaches this point.
+int rsdma_release(int slot, int k, hipStream_t stream) {
+  if (slot < 0 || slot >= (int)g_slots.size() || k < 0 || k >= kTriggers)
+    return -2;
+  hipLaunchKernelGGL(
+      release_trigger,
+      dim3(1),
+      dim3(1),
+      0,
+      stream,
+      const_cast<hsa_signal_value_t*>(g_slots[slot].trigger_value[k]));
+  return hipGetLastError() == hipSuccess ? 0 : -1;
+}
+
+// Enqueues on `stream` a wait until the `count` 32-bit flags at `words` all
+// read 1. A wait that finds a flag from a sender that abandoned the call, or
+// is still missing flags after `seconds`, is recorded (rsdma_peek_error,
+// rsdma_take_error); then the stream moves on.
+int rsdma_wait_flags(
+    hipStream_t stream,
+    uint64_t words,
+    int count,
+    double seconds,
+    int piece,
+    int call) {
+  if (count > 64)
+    return -1;
+  unsigned long long budget =
+      (unsigned long long)(seconds * (double)g_ticks_per_s);
+  hipLaunchKernelGGL(
+      wait_flags,
+      dim3(1),
+      dim3(1),
+      0,
+      stream,
+      (const int*)words,
+      count,
+      budget,
+      g_error,
+      piece,
+      call);
+  return hipGetLastError() == hipSuccess ? 0 : -2;
+}
+
+// Enqueues on `stream` a barrier of `world` ranks (see barrier): `peers` is a
+// device array of every rank's arrival words, mapped here, `own` this rank's,
+// `epoch` a device word only this rank's barriers on them use. A barrier still
+// missing ranks after `seconds` is recorded as a failure with piece -2.
+int rsdma_barrier(
+    hipStream_t stream,
+    uint64_t peers,
+    uint64_t own,
+    int world,
+    int rank,
+    uint64_t epoch,
+    double seconds,
+    int call) {
+  if (world > 64 || rank < 0 || rank >= world)
+    return -1;
+  unsigned long long budget =
+      (unsigned long long)(seconds * (double)g_ticks_per_s);
+  hipLaunchKernelGGL(
+      barrier,
+      dim3(1),
+      dim3(1),
+      0,
+      stream,
+      (unsigned long long* const*)peers,
+      (const unsigned long long*)own,
+      world,
+      rank,
+      (unsigned long long*)epoch,
+      budget,
+      g_error,
+      call);
+  return hipGetLastError() == hipSuccess ? 0 : -2;
+}
+
+static_assert(sizeof(hipIpcMemHandle_t) == 64, "rsdma_ipc_* pass 64-byte handles");
+
+// `size` bytes of zeroed device memory at *ptr, and the hipIpc handle (64
+// bytes) that maps them in another process.
+int rsdma_ipc_alloc(uint64_t size, void** ptr, char* handle) {
+  if (hipMalloc(ptr, size) != hipSuccess)
+    return -1;
+  if (hipMemset(*ptr, 0, size) != hipSuccess ||
+      hipDeviceSynchronize() != hipSuccess)
+    return -2;
+  hipIpcMemHandle_t h;
+  if (hipIpcGetMemHandle(&h, *ptr) != hipSuccess)
+    return -3;
+  memcpy(handle, &h, sizeof(h));
+  return 0;
+}
+
+// Maps another process's rsdma_ipc_alloc memory at *ptr.
+int rsdma_ipc_open(const char* handle, void** ptr) {
+  hipIpcMemHandle_t h;
+  memcpy(&h, handle, sizeof(h));
+  return hipIpcOpenMemHandle(ptr, h, hipIpcMemLazyEnablePeerAccess) ==
+          hipSuccess
+      ? 0
+      : -1;
+}
+
+// How many failures were recorded (0 if none) and the first one's piece, call
+// id, status and missing-flag mask, without clearing the record: for a watchdog
+// that polls it.
+int rsdma_peek_error(int* piece, int* call, int* status, uint64_t* missing) {
+  volatile RsdmaError* e = g_error;
+  if (e == nullptr)
+    return 0;
+  unsigned long long count = e->count;
+  if (count == 0)
+    return 0;
+  *piece = e->piece;
+  *call = e->call;
+  *status = e->status;
+  *missing = e->missing;
+  return (int)(count > 0x7fffffff ? 0x7fffffff : count);
+}
+
+// As rsdma_peek_error, and clears the record.
+int rsdma_take_error(int* piece, int* call, int* status, uint64_t* missing) {
+  int count = rsdma_peek_error(piece, call, status, missing);
+  if (count)
+    g_error->count = 0;
+  return count;
+}
+
+// Test hook: the next issue of piece `piece` diverts its flag write for peer
+// index `index` to a scratch word, as if it were lost.
+int rsdma_debug_drop_flag(int piece, int index) {
+  g_drop_piece = piece;
+  g_drop_index = index;
+  return 0;
+}
+}
