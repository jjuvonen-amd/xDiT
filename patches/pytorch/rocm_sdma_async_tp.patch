+def _inbox(
+    group_name: str, rank: int, world: int, shape, dtype: torch.dtype, chunks: int
+):
+    """This rank's symmetric inbox of `shape` and its (chunks, world) int32 flag words, plus every
+    rank's workspace base address and the flags' byte offset in it."""
+    nbytes = torch.empty((), dtype=dtype).element_size()
+    for d in shape:
+        nbytes *= d
+    flag_offset = -(-nbytes // 64) * 64
+    size = flag_offset + chunks * world * 4
+    ws = symm_mem.get_symm_mem_workspace(group_name, min_size=size)
+    inbox = ws.get_buffer(rank, tuple(shape), dtype)
+    flags = ws.get_buffer(
+        rank, (chunks, world), torch.int32, storage_offset=flag_offset // 4
+    )
+    bases = [ws.get_buffer(r, (size,), torch.uint8).data_ptr() for r in range(world)]
+    return ws, inbox, flags, bases, flag_offset
+
+
+def _barrier(ws) -> None:
+    # A peer may reach the barrier only after all of its own bounded waits gave up, one per piece.
+    ws.barrier(channel=0, timeout_ms=int(_timeout_s() * (MAX_CHUNKS + 2) * 1000))
+
+
+def _chunks(rows: int) -> int:
+    """Pieces per rank: TORCH_SYMM_MEM_ROCM_SDMA_CHUNKS, or the largest smaller count dividing `rows`."""
+    want = int(_env("ROCM_SDMA_CHUNKS", "4"))
+    if not 1 <= want <= MAX_CHUNKS:
+        raise ValueError(
+            f"TORCH_SYMM_MEM_ROCM_SDMA_CHUNKS must be 1 to {MAX_CHUNKS}; got {want}"
+        )
+    return max(c for c in range(1, want + 1) if rows % c == 0)
