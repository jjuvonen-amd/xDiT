+    def test_bfloat16_batch_and_chunks(self, chunks: int) -> None:
+        """Several pieces per rank in flight at once, a batch of two, two Bs."""
+        self._init_process()
+        group_name = dist.group.WORLD.group_name
+        A_shard = torch.randn(2, 384, 512, device=device_type, dtype=torch.bfloat16)
+        Bs = [
+            torch.randn(640, 512, device=device_type, dtype=torch.bfloat16).t(),
+            torch.randn(512, 256, device=device_type, dtype=torch.bfloat16),
+        ]
+        A = torch.randn(
+            2, 384 * self.world_size, 512, device=device_type, dtype=torch.bfloat16
+        )
+
+        env = {**_ROCM_SDMA_ENV, "TORCH_SYMM_MEM_ROCM_SDMA_CHUNKS": str(chunks)}
+        with mock.patch.dict(os.environ, env):
+            ag_1, mm_1 = torch.ops.symm_mem.fused_all_gather_matmul(
+                A_shard, Bs, gather_dim=1, group_name=group_name, return_A=False
+            )
+            rs_1 = torch.ops.symm_mem.fused_matmul_reduce_scatter(
+                A, Bs[1], "sum", scatter_dim=1, group_name=group_name
+            )
+        _, mm_0 = _fused_all_gather_matmul_fallback(
+            A_shard.float(),
+            [B.float() for B in Bs],
+            gather_dim=1,
+            group_name=group_name,
+        )
+        rs_0 = _fused_matmul_reduce_scatter_fallback(
+            A.float(), Bs[1].float(), "sum", scatter_dim=1, group_name=group_name
+        )
+
+        self.assertIsNone(ag_1)
+        for out_1, out_0 in zip(mm_1, mm_0):
+            self._assert_close_to_fp32(out_1, out_0)
+        self._assert_close_to_fp32(rs_1, rs_0)
