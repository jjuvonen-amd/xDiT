+# The SDMA path on any ROCm GPU, validated or not (see _rocm_sdma.py).
+_ROCM_SDMA_ENV = {
+    "TORCH_SYMM_MEM_ENABLE_ROCM_SDMA": "1",
+    "TORCH_SYMM_MEM_ROCM_SDMA_ALLOW_UNTESTED": "1",
+}
+
+
+def _each_inbox(test):
+    """Runs `test` with each inbox of the SDMA path (TORCH_SYMM_MEM_ROCM_SDMA_INBOX)."""
+
+    @functools.wraps(test)
+    def run(self, *args, inbox: str, **kwargs):
+        with mock.patch.dict(os.environ, {"TORCH_SYMM_MEM_ROCM_SDMA_INBOX": inbox}):
+            return test(self, *args, **kwargs)
+
+    return parametrize("inbox", ["ipc", "symm_mem"])(run)
+
+
+def _rocm_sdma_num_calls() -> dict[str, int]:
+    from torch.distributed._symmetric_memory import _rocm_sdma
+
+    return _rocm_sdma.num_calls
+
+
+@skipIf(not TEST_WITH_ROCM, "the SDMA path of the fused ops is ROCm only")
+@skipIf(not PLATFORM_SUPPORTS_SYMM_MEM, "SymmMem is not supported on this ROCm arch")
+@instantiate_parametrized_tests
+@requires_accelerator_p2p_access()
+class AsyncTPRocmSdmaTest(MultiProcContinuousTest):
+    """The fused ops with TORCH_SYMM_MEM_ENABLE_ROCM_SDMA=1 match their fallbacks,
+    and the cases the SDMA path supports take it."""
+
+    @property
+    def device(self) -> torch.device:
+        return torch.device(device_type, self.rank)
+
+    def _init_process(self):
+        device_module.set_device(self.device)
+        torch.manual_seed(42 + self.rank)
+
+    @staticmethod
+    def _sdma_calls(op: str) -> int:
+        from torch.distributed._symmetric_memory import _rocm_sdma
+
+        return _rocm_sdma.num_calls[op]
+
+    def _assert_close_to_fp32(self, actual, expected) -> None:
+        # bf16 results against an fp32 reference of the same bf16 inputs: the
+        # fallback's own bf16 reduce-scatter rounds each partial sum it adds,
+        # so it is no closer to the exact result than this path.
+        scale = expected.float().abs().max().item()
+        torch.testing.assert_close(
+            actual.float(), expected.float(), rtol=2e-2, atol=1e-2 * scale
+        )
+
+    @skip_if_lt_x_gpu(2)
+    @parametrize("gather_dim", [0, 1, 2])
+    @mock.patch.dict(os.environ, _ROCM_SDMA_ENV)
+    @_each_inbox
+    def test_fused_all_gather_matmul(self, gather_dim: int) -> None:
+        self._init_process()
+        BATCH, M, N, K = 8, 64, 16, 32
+        group_name = dist.group.WORLD.group_name
+        A_shard_shape = [BATCH, M, K]
+        A_shard_shape[gather_dim] //= self.world_size
+        A_shard = torch.rand(A_shard_shape, device=device_type)
+        Bs = [torch.rand(K, N, device=device_type) for _ in range(3)]
+
+        calls = self._sdma_calls("fused_all_gather_matmul")
+        ag_0, mm_0 = _fused_all_gather_matmul_fallback(
+            A_shard, Bs, gather_dim=gather_dim, group_name=group_name
+        )
+        ag_1, mm_1 = torch.ops.symm_mem.fused_all_gather_matmul(
+            A_shard, Bs, gather_dim=gather_dim, group_name=group_name
+        )
+
+        # Gathering the last dim is left to the default path.
+        self.assertEqual(
+            self._sdma_calls("fused_all_gather_matmul") - calls,
+            0 if gather_dim == 2 else 1,
+        )
+        torch.testing.assert_close(ag_1, ag_0, rtol=0, atol=0)
+        self.assertEqual(ag_1.stride(), ag_0.stride())
+        for out_1, out_0 in zip(mm_1, mm_0):
+            torch.testing.assert_close(out_1, out_0)
+            self.assertEqual(out_1.stride(), out_0.stride())
+
+    @skip_if_lt_x_gpu(2)
+    @parametrize("scatter_dim", [0, 1, 2])
+    @mock.patch.dict(os.environ, _ROCM_SDMA_ENV)
+    @_each_inbox
+    def test_fused_matmul_reduce_scatter(self, scatter_dim: int) -> None:
+        self._init_process()
+        BATCH, M, N, K = 8, 64, 16, 1024
+        group_name = dist.group.WORLD.group_name
+        A = torch.rand(BATCH, M, K, device=device_type)
+        B = torch.rand(K, N, device=device_type)
+
+        calls = self._sdma_calls("fused_matmul_reduce_scatter")
+        output_0 = _fused_matmul_reduce_scatter_fallback(
+            A, B, "avg", scatter_dim=scatter_dim, group_name=group_name
+        )
+        output_1 = torch.ops.symm_mem.fused_matmul_reduce_scatter(
+            A, B, "avg", scatter_dim=scatter_dim, group_name=group_name
+        )
+
+        # Scattering the last dim is left to the default path.
+        self.assertEqual(
+            self._sdma_calls("fused_matmul_reduce_scatter") - calls,
+            0 if scatter_dim == 2 else 1,
+        )
+        torch.testing.assert_close(output_1, output_0, rtol=1e-5, atol=1e-5)
+        self.assertEqual(output_1.stride(), output_0.stride())
+
+    def test_auto_chunks(self) -> None:
+        """Without TORCH_SYMM_MEM_ROCM_SDMA_CHUNKS, the piece count follows the bytes per rank."""
+        from torch.distributed._symmetric_memory import _rocm_sdma
+
+        piece = _rocm_sdma.AUTO_MIN_PIECE_BYTES
+        with mock.patch.dict(os.environ, {"TORCH_SYMM_MEM_ROCM_SDMA_CHUNKS": ""}):
+            self.assertEqual(_rocm_sdma._chunks(64, piece // 128), 1)
+            self.assertEqual(_rocm_sdma._chunks(64, piece // 32), 2)
+            self.assertEqual(_rocm_sdma._chunks(64, piece // 11), 4)
+            self.assertEqual(_rocm_sdma._chunks(64, piece), 8)
+            # Lowered to a count that divides the rows.
+            self.assertEqual(_rocm_sdma._chunks(66, piece), 6)
+        with mock.patch.dict(os.environ, {"TORCH_SYMM_MEM_ROCM_SDMA_CHUNKS": "3"}):
+            self.assertEqual(_rocm_sdma._chunks(64, piece), 2)
+
+    @skip_if_lt_x_gpu(2)
+    @parametrize("chunks", [1, 3, 4])
+    def test_bfloat16_batch_and_chunks(self, chunks: int) -> None:
+        """Several pieces per rank in flight at once, a batch of two, two Bs."""
+        self._init_process()
+        group_name = dist.group.WORLD.group_name
+        A_shard = torch.randn(2, 384, 512, device=device_type, dtype=torch.bfloat16)
+        Bs = [
+            torch.randn(640, 512, device=device_type, dtype=torch.bfloat16).t(),
+            torch.randn(512, 256, device=device_type, dtype=torch.bfloat16),
+        ]
+        A = torch.randn(
+            2, 384 * self.world_size, 512, device=device_type, dtype=torch.bfloat16
+        )
+
+        env = {**_ROCM_SDMA_ENV, "TORCH_SYMM_MEM_ROCM_SDMA_CHUNKS": str(chunks)}
+        with mock.patch.dict(os.environ, env):
+            ag_1, mm_1 = torch.ops.symm_mem.fused_all_gather_matmul(
+                A_shard, Bs, gather_dim=1, group_name=group_name, return_A=False
+            )
+            rs_1 = torch.ops.symm_mem.fused_matmul_reduce_scatter(
+                A, Bs[1], "sum", scatter_dim=1, group_name=group_name
+            )
+        _, mm_0 = _fused_all_gather_matmul_fallback(
+            A_shard.float(),
+            [B.float() for B in Bs],
+            gather_dim=1,
+            group_name=group_name,
+        )
+        rs_0 = _fused_matmul_reduce_scatter_fallback(
+            A.float(), Bs[1].float(), "sum", scatter_dim=1, group_name=group_name
+        )
+
+        self.assertIsNone(ag_1)
+        for out_1, out_0 in zip(mm_1, mm_0):
+            self._assert_close_to_fp32(out_1, out_0)
+        self._assert_close_to_fp32(rs_1, rs_0)
+
+    @skip_if_lt_x_gpu(2)
+    @mock.patch.dict(os.environ, _ROCM_SDMA_ENV)
+    def test_fused_matmul_reduce_scatter_bfloat16_custom_reduce(self) -> None:
+        self._init_process()
+        M, N, K = 64, 32, 1024
+        group_name = dist.group.WORLD.group_name
+        A = torch.rand(M, K, device=device_type, dtype=torch.bfloat16)
+        B = torch.rand(K, N, device=device_type, dtype=torch.bfloat16)
+
+        output_0 = _fused_matmul_reduce_scatter_fallback(
+            A, B, "avg", scatter_dim=0, group_name=group_name
+        )
+        output_1 = torch.ops.symm_mem.fused_matmul_reduce_scatter(
+            A, B, "avg", scatter_dim=0, group_name=group_name
+        )
+        torch.testing.assert_close(output_0, output_1, rtol=1e-2, atol=1e-2)
+        self.assertEqual(output_0.stride(), output_1.stride())
+
+    @skip_if_lt_x_gpu(2)
+    @mock.patch.dict(os.environ, _ROCM_SDMA_ENV)
+    @_each_inbox
+    def test_graph_capture(self) -> None:
+        """Captured calls issue their copies from a host-function node on every
+        replay."""
+        self._init_process()
+        group_name = dist.group.WORLD.group_name
+        A_shard = torch.randn(1, 256, 128, device=device_type, dtype=torch.bfloat16)
+        A = torch.randn(
+            1, 256 * self.world_size, 128, device=device_type, dtype=torch.bfloat16
+        )
+        B = torch.randn(128, 96, device=device_type, dtype=torch.bfloat16)
+
+        # Eager calls with the same shapes size the workspace, which cannot grow
+        # during capture.
+        torch.ops.symm_mem.fused_all_gather_matmul(A_shard, [B], 1, group_name)
+        torch.ops.symm_mem.fused_matmul_reduce_scatter(A, B, "sum", 1, group_name)
+        calls = self._sdma_calls("fused_all_gather_matmul")
+        graph = graph_cls()
+        with device_module.graph(graph):
+            ag_1, (mm_1,) = torch.ops.symm_mem.fused_all_gather_matmul(
+                A_shard, [B], 1, group_name
+            )
+            rs_1 = torch.ops.symm_mem.fused_matmul_reduce_scatter(
+                A, B, "sum", 1, group_name
+            )
+        self.assertEqual(self._sdma_calls("fused_all_gather_matmul") - calls, 1)
+
+        for _ in range(5):
+            A_shard.copy_(torch.randn_like(A_shard))
+            A.copy_(torch.randn_like(A))
+            graph.replay()
+            ag_0, (mm_0,) = _fused_all_gather_matmul_fallback(
+                A_shard.float(), [B.float()], gather_dim=1, group_name=group_name
+            )
+            rs_0 = _fused_matmul_reduce_scatter_fallback(
+                A.float(), B.float(), "sum", scatter_dim=1, group_name=group_name
+            )
+            torch.testing.assert_close(ag_1.float(), ag_0, rtol=0, atol=0)
+            self._assert_close_to_fp32(mm_1, mm_0)
+            self._assert_close_to_fp32(rs_1, rs_0)
+
+    @skip_if_lt_x_gpu(4)
+    @mock.patch.dict(os.environ, _ROCM_SDMA_ENV)
+    @_each_inbox
+    def test_two_process_groups(self) -> None:
+        """Calls alternate between the whole group and halves of it."""
+        self._init_process()
+        half = self.world_size // 2
+        halves = [
+            dist.new_group(list(range(i * half, (i + 1) * half))) for i in range(2)
+        ]
+        mine = halves[self.rank // half]
+        for group in [dist.group.WORLD, mine, dist.group.WORLD, mine]:
+            A_shard = torch.randn(1, 128, 256, device=device_type, dtype=torch.bfloat16)
+            B = torch.randn(256, 64, device=device_type, dtype=torch.bfloat16)
+            ag_1, (mm_1,) = torch.ops.symm_mem.fused_all_gather_matmul(
+                A_shard, [B], 1, group.group_name
+            )
+            ag_0, (mm_0,) = _fused_all_gather_matmul_fallback(
+                A_shard.float(), [B.float()], gather_dim=1, group_name=group.group_name
+            )
+            torch.testing.assert_close(ag_1.float(), ag_0, rtol=0, atol=0)
+            self._assert_close_to_fp32(mm_1, mm_0)
+
+    @skip_if_lt_x_gpu(2)
+    @mock.patch.dict(
+        os.environ,
+        {
+            **_ROCM_SDMA_ENV,
+            "TORCH_SYMM_MEM_ROCM_SDMA_ON_TIMEOUT": "raise",
+            "TORCH_SYMM_MEM_ROCM_SDMA_TIMEOUT_S": "2",
+            "TORCH_SYMM_MEM_ROCM_SDMA_CHUNKS": "2",
+        },
+    )
+    def test_lost_flag_is_reported(self) -> None:
+        """A flag that never lands ends its wait after the timeout and is reported."""
+        from torch.distributed._symmetric_memory import _rocm_sdma
+
+        self._init_process()
+        group_name = dist.group.WORLD.group_name
+        A_shard = torch.randn(256, 128, device=device_type, dtype=torch.bfloat16)
+        B = torch.randn(128, 64, device=device_type, dtype=torch.bfloat16)
+        torch.ops.symm_mem.fused_all_gather_matmul(
+            A_shard, [B], 0, group_name, return_A=False
+        )
+        device_module.synchronize()
+        if self.rank == 0:
+            # Piece 1 of rank 0's next call loses its flag write to its first
+            # peer, rank 1.
+            _rocm_sdma.debug_drop_flag(1, 0)
+        torch.ops.symm_mem.fused_all_gather_matmul(
+            A_shard, [B], 0, group_name, return_A=False
+        )
+        device_module.synchronize()
+        dist.barrier()
+        if self.rank == 1:
+            with self.assertRaisesRegex(
+                RuntimeError, r"piece 1: flag words \[0\] never set"
+            ):
+                _rocm_sdma.raise_if_failed()
+        else:
+            _rocm_sdma.raise_if_failed()
+
+    def _all_four_ops(self, group) -> None:
+        """One call of each op that takes the SDMA path, checked against the fallbacks."""
+        rows, N, K = 256, 64, 128
+        group_name, world = group.group_name, group.size()
+        x = torch.randn(rows, K, device=device_type, dtype=torch.bfloat16)
+        X = torch.randn(rows * world, K, device=device_type, dtype=torch.bfloat16)
+        W = torch.randn(K, N, device=device_type, dtype=torch.bfloat16)
+        xq, xs = self._fp8(rows, K), self._scales(rows, 1)
+        Xq, Xs = self._fp8(rows * world, K), self._scales(rows * world, 1)
+        Wq, Ws = self._fp8(N, K).T, self._scales(1, N)
+        scaled = dict(
+            group_name=group_name,
+            biases=[None],
+            result_scales=[None],
+            out_dtypes=[torch.bfloat16],
+            use_fast_accum=[False],
+        )
+
+        _, (ag,) = torch.ops.symm_mem.fused_all_gather_matmul(x, [W], 0, group_name)
+        _, (ag_ref,) = _fused_all_gather_matmul_fallback(
+            x.float(), [W.float()], gather_dim=0, group_name=group_name
+        )
+        self._assert_close_to_fp32(ag, ag_ref)
+        rs = torch.ops.symm_mem.fused_matmul_reduce_scatter(X, W, "sum", 0, group_name)
+        rs_ref = _fused_matmul_reduce_scatter_fallback(
+            X.float(), W.float(), "sum", scatter_dim=0, group_name=group_name
+        )
+        self._assert_close_to_fp32(rs, rs_ref)
+        _, (ag8,) = torch.ops.symm_mem.fused_all_gather_scaled_matmul(
+            xq, [Wq], xs, [Ws], gather_dim=0, **scaled
+        )
+        _, (ag8_ref,) = _fused_all_gather_scaled_matmul_fallback(
+            xq, [Wq], xs, [Ws], gather_dim=0, **scaled
+        )
+        self._assert_close_scaled(ag8, ag8_ref)
+        rs8 = torch.ops.symm_mem.fused_scaled_matmul_reduce_scatter(
+            Xq, Wq, Xs, Ws, "sum", 0, 0, group_name, [rows * world, N],
+            out_dtype=torch.bfloat16,
+        )
+        rs8_ref = _fused_scaled_matmul_reduce_scatter_fallback(
+            Xq, Wq, Xs, Ws, "sum", 0, 0, group_name, [rows * world, N],
+            out_dtype=torch.bfloat16,
+        )
+        self._assert_close_to_fp32(rs8, rs8_ref)
+
+    @skip_if_lt_x_gpu(2)
+    @mock.patch.dict(
+        os.environ, {**_ROCM_SDMA_ENV, "TORCH_SYMM_MEM_ROCM_SDMA_INBOX": "ipc"}
+    )
+    def test_ipc_inbox_never_rendezvous(self) -> None:
+        """With the ipc inbox, the SDMA path (setting up a new group included) allocates no
+        symmetric memory."""
+        self._init_process()
+        group = dist.new_group(list(range(self.world_size)))
+        calls = dict(_rocm_sdma_num_calls())
+
+        def refuse(*args, **kwargs):
+            raise AssertionError("the SDMA path rendezvoused symmetric memory")
+
+        # The fallbacks the results are checked against allocate no symmetric memory either.
+        with (
+            mock.patch.object(symm_mem, "rendezvous", refuse),
+            mock.patch.object(symm_mem, "get_symm_mem_workspace", refuse),
+        ):
+            self._all_four_ops(group)
+            device_module.synchronize()
+        for op, n in _rocm_sdma_num_calls().items():
+            self.assertEqual(n - calls[op], 1, op)
+
+    @skip_if_lt_x_gpu(2)
+    @mock.patch.dict(
+        os.environ, {**_ROCM_SDMA_ENV, "TORCH_SYMM_MEM_ROCM_SDMA_INBOX": "ipc"}
+    )
+    def test_ipc_inbox_grows(self) -> None:
+        """A call larger than the inbox grows it; calls of either size stay right after."""
+        from torch.distributed._symmetric_memory import _rocm_sdma
+
+        self._init_process()
+        group_name = dist.new_group(list(range(self.world_size))).group_name
+        sizes = []
+        for rows in [128, 1024, 128, 1024]:
+            A_shard = torch.randn(rows, 256, device=device_type, dtype=torch.bfloat16)
+            B = torch.randn(256, 64, device=device_type, dtype=torch.bfloat16)
+            ag_1, (mm_1,) = torch.ops.symm_mem.fused_all_gather_matmul(
+                A_shard, [B], 0, group_name
+            )
+            ag_0, (mm_0,) = _fused_all_gather_matmul_fallback(
