+    @skip_if_lt_x_gpu(2)
+    @mock.patch.dict(
+        os.environ,
+        {
+            **_ROCM_SDMA_ENV,
+            "TORCH_SYMM_MEM_ROCM_SDMA_ON_TIMEOUT": "raise",
+            "TORCH_SYMM_MEM_ROCM_SDMA_TIMEOUT_S": "2",
+            "TORCH_SYMM_MEM_ROCM_SDMA_CHUNKS": "2",
+        },
+    )
+    def test_lost_flag_is_reported(self) -> None:
+        """A flag that never lands ends its wait after the timeout and is reported."""
+        from torch.distributed._symmetric_memory import _rocm_sdma
+
+        self._init_process()
+        group_name = dist.group.WORLD.group_name
+        A_shard = torch.randn(256, 128, device=device_type, dtype=torch.bfloat16)
+        B = torch.randn(128, 64, device=device_type, dtype=torch.bfloat16)
+        torch.ops.symm_mem.fused_all_gather_matmul(
+            A_shard, [B], 0, group_name, return_A=False
+        )
+        device_module.synchronize()
+        if self.rank == 0:
+            # Piece 1 of rank 0's next call loses its flag write to its first
+            # peer, rank 1.
+            _rocm_sdma.debug_drop_flag(1, 0)
+        torch.ops.symm_mem.fused_all_gather_matmul(
+            A_shard, [B], 0, group_name, return_A=False
+        )
+        device_module.synchronize()
+        dist.barrier()
+        if self.rank == 1:
+            with self.assertRaisesRegex(
+                RuntimeError, r"piece 1: flag words \[0\] never set"
+            ):
+                _rocm_sdma.raise_if_failed()
+        else:
+            _rocm_sdma.raise_if_failed()
+
