+    piece, call, status, missing = (
+        ctypes.c_int(),
+        ctypes.c_int(),
+        ctypes.c_int(),
+        ctypes.c_uint64(),
+    )
+    count = _load().rsdma_take_error(
+        ctypes.byref(piece),
+        ctypes.byref(call),
+        ctypes.byref(status),
+        ctypes.byref(missing),
+    )
+    if count:
+        raise RuntimeError(
+            _failure_message(
+                count, piece.value, call.value, status.value, missing.value
