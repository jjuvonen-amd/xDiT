+class _Plan:
+    """The host side of one call: its slot, call id and the pieces its SDMA engines push."""
+
+    def __init__(self, lib, g: _Group, pieces: int, copies_per_peer: int):
+        global _next_eager_slot, _next_capture_slot, _last_call
