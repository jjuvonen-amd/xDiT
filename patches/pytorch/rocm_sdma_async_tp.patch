+    # Every rank waited for every piece before its last matmul, so past this barrier no copy reads
+    # or writes this call's inboxes.
+    _barrier(ws)
+    num_calls["fused_all_gather_matmul"] += 1
+
+    def unflatten(t: torch.Tensor) -> torch.Tensor:
+        return t.view(*leading_dims, -1).flatten(0, 1).movedim(0, gather_dim)
+
+    return (unflatten(A) if A is not None else None), [
+        unflatten(out) for out in outputs
+    ]
