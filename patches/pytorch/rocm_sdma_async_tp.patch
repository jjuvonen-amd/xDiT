+    block = rows // chunks
+    elt = x.element_size()
+    piece_bytes = block * features * elt
+    stream = torch.cuda.current_stream()
+
+    # The inbox is the gathered A: rank r's rows at r * rows.
+    ws, inbox, flags, bases, flag_offset = _inbox(
+        group_name, rank, world, (world, rows, features), x.dtype, chunks
+    )
+    plan = _Plan(lib, g, chunks, 1)
+    own = (
+        bases[rank] + rank * rows * features * elt
+    )  # this rank's rows in its own inbox: the copies' source
+    one = _one(x.device).data_ptr()
+    for c in range(chunks):
+        offset = (rank * rows + c * block) * features * elt
+        plan.push(
+            0,
+            [bases[p] + offset for p in g.peers],
+            [own + c * piece_bytes] * n,
+            piece_bytes,
+            [bases[p] + flag_offset + (c * world + rank) * 4 for p in g.peers],
+            one,
+        )
+    flags.zero_()
+    flags[:, rank] = 1
+    inbox[rank].copy_(x)
+    outputs = [x.new_empty(world * rows, B.shape[1], dtype=B.dtype) for B in Bs]
+
+    # Every rank's own rows and cleared flags are in place, and its inbox is free, past this barrier.
+    _barrier(ws)
+    # Issued after the kernels above are enqueued, so the GPU runs them meanwhile; the copies
+    # wait for the release.
+    plan.start(stream)
+    plan.release(0, stream)
+    pieces = inbox.view(world, chunks, block, features)
+    for c in range(chunks):
+        plan.wait(stream, flags[c], c)
+        for B, out in zip(Bs, outputs):
+            torch.bmm(
+                pieces[:, c],
+                B.expand(world, *B.shape),
+                out=out.view(world, chunks, block, -1)[:, c],
+            )
