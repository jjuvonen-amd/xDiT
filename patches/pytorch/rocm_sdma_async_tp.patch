+        group_name, rank, world, [(shape, dtype)], chunks
+    )
+    # partials[c, r] = this rank's partial sums for piece c of owner r's rows.
+    partials = torch.empty(shape, dtype=dtype, device=inbox.device)
+    plan = _Plan(lib, g, chunks, 1)
+    for c in range(chunks):
+        # Piece c is pushed once its matmul is done: trigger c.
+        plan.push(
+            c,
+            [bases[p] + (c * world + rank) * block_bytes for p in g.peers],
+            [partials[c, p].data_ptr() for p in g.peers],
+            [block_bytes],
+            [bases[p] + flag_offset + (c * world + rank) * 4 for p in g.peers],
