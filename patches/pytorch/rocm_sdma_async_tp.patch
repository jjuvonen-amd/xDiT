+    """all_gather(A_shard, gather_dim) @ B for every B in Bs, as symm_mem.fused_all_gather_matmul."""
+    world = _group(group_name).world
+    x, unflatten = _gather_rows(A_shard, gather_dim, world)
+    rows = x.shape[0]
+    chunks = _chunks(rows, x.shape[1] * x.element_size())
+    block = rows // chunks
+    outputs = [x.new_empty(world * rows, B.shape[1], dtype=B.dtype) for B in Bs]
+
