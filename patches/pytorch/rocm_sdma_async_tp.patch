+    @skip_if_lt_x_gpu(2)
+    @mock.patch.dict(os.environ, _ROCM_SDMA_ENV)
+    def test_graph_capture(self) -> None:
+        """Captured calls issue their copies from a host-function node on every
+        replay."""
+        self._init_process()
+        group_name = dist.group.WORLD.group_name
+        A_shard = torch.randn(1, 256, 128, device=device_type, dtype=torch.bfloat16)
+        A = torch.randn(
+            1, 256 * self.world_size, 128, device=device_type, dtype=torch.bfloat16
+        )
+        B = torch.randn(128, 96, device=device_type, dtype=torch.bfloat16)
+
+        # Eager calls with the same shapes size the workspace, which cannot grow
+        # during capture.
+        torch.ops.symm_mem.fused_all_gather_matmul(A_shard, [B], 1, group_name)
+        torch.ops.symm_mem.fused_matmul_reduce_scatter(A, B, "sum", 1, group_name)
+        calls = self._sdma_calls("fused_all_gather_matmul")
+        graph = graph_cls()
+        with device_module.graph(graph):
+            ag_1, (mm_1,) = torch.ops.symm_mem.fused_all_gather_matmul(
+                A_shard, [B], 1, group_name
+            )
+            rs_1 = torch.ops.symm_mem.fused_matmul_reduce_scatter(
+                A, B, "sum", 1, group_name
+            )
+        self.assertEqual(self._sdma_calls("fused_all_gather_matmul") - calls, 1)
+
+        for _ in range(5):
+            A_shard.copy_(torch.randn_like(A_shard))
+            A.copy_(torch.randn_like(A))
+            graph.replay()
+            ag_0, (mm_0,) = _fused_all_gather_matmul_fallback(
+                A_shard.float(), [B.float()], gather_dim=1, group_name=group_name
+            )
+            rs_0 = _fused_matmul_reduce_scatter_fallback(
+                A.float(), B.float(), "sum", scatter_dim=1, group_name=group_name
+            )
+            torch.testing.assert_close(ag_1.float(), ag_0, rtol=0, atol=0)
+            self._assert_close_to_fp32(mm_1, mm_0)
+            self._assert_close_to_fp32(rs_1, rs_0)
+
