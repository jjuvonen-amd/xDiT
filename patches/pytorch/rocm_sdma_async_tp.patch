+    def _raise_in_bmm(self, call: int):
+        """On rank 0, torch.bmm raises on its `call`-th call (from 0); other ranks run it."""
+        bmm, calls = torch.bmm, [0]
+
+        def fail(*args, **kwargs):
+            calls[0] += 1
+            if self.rank == 0 and calls[0] == call + 1:
+                raise RuntimeError("injected")
+            return bmm(*args, **kwargs)
+
+        return mock.patch.object(torch, "bmm", fail)
