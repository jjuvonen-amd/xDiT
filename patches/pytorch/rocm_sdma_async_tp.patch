+            ctypes.c_int(),
+            ctypes.c_int(),
+            ctypes.c_int(),
+            ctypes.c_uint64(),
+        )
+        while True:
+            count = lib.rsdma_peek_error(
+                ctypes.byref(piece),
+                ctypes.byref(call),
+                ctypes.byref(status),
+                ctypes.byref(missing),
+            )
+            if count and _on_timeout() == "abort":
+                message = _failure_message(
+                    count, piece.value, call.value, status.value, missing.value
+                )
+                logger.error("%s; aborting", message)
+                print(f"{message}; aborting", file=sys.stderr, flush=True)
+                os.abort()
+            time.sleep(0.1)
